rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /incidents/{imageId} {
      // Permitir la lectura a cualquier usuario autenticado de la red
      allow read: if request.auth != null;

      // Permitir la subida de fotos únicamente a usuarios autenticados,
      // validando que el archivo sea efectivamente una imagen y pese menos de 10MB.
      allow write: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /road-tests/{uploaderUid}/{roadTestId}/{allPaths=**} {
      // N-R3: fotos del test drive (licencia, conductor, vehículo) solo las
      // lee quien las subió (el getDownloadURL posterior a la subida). El
      // admin consulta el metadato en Firestore (roadTests, solo ADMIN);
      // nadie más necesita la imagen. El uid del uploader va en el path
      // porque Storage no puede consultar Firestore.
      allow read, write: if request.auth != null
                    && request.auth.uid == uploaderUid
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
