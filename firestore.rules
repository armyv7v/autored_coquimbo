rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }
    function isSecurity() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SECURITY']; }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data));
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
          && data.uid == userId
          && data.role in ['ADMIN', 'OWNER', 'SECURITY']
          && data.email is string;
      }
    }

    // --- Dealerships ---
    match /dealerships/{dealershipId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Public access requests ---
    match /accessRequests/{rutKey} {
      allow create: if request.resource.data.keys().hasAll([
          'dealershipName',
          'rut',
          'rutKey',
          'contactName',
          'phone',
          'email',
          'address',
          'requestedRole',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'dealershipName',
          'rut',
          'rutKey',
          'contactName',
          'phone',
          'email',
          'address',
          'requestedRole',
          'status',
          'createdAt'
        ])
        && request.resource.data.rutKey == rutKey
        && request.resource.data.requestedRole == 'OWNER'
        && request.resource.data.status == 'PENDING'
        && request.resource.data.dealershipName is string
        && request.resource.data.rut is string
        && request.resource.data.contactName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.address is string;
      allow get, list, update, delete: if isAdmin();
    }

    // --- Incidents ---
    match /incidents/{incidentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSecurity() || resource.data.reporterId == request.auth.uid);
    }

    // --- Alerts ---
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
    }

    // --- Road Tests ---
    match /roadTests/{roadTestId} {
      allow get, list, create, update: if isSignedIn();
    }

    // --- Stolen Vehicles Registry (AutoSeguro / AutoRed) ---
    match /stolenVehiclesRegistry/{plate} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
